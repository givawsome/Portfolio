    "jsdom": "^30.1.3",
    "mongodb": "^6.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "supertest": "^7.1.0"
