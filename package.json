{
  "name": "rajneesh-portfolio-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/local.js",
    "start": "node --env-file-if-exists=.env server/local.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test",
